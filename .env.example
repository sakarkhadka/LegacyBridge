# Required for real discovery runs.
# Replay must work without this value.
OPENAI_API_KEY=

# Local demo app defaults.
DEMO_APP_ORIGIN=http://localhost:3000
EVIDENCE_DIR=evidence

# Runtime login defaults for the authenticated demo app.
# read/r123 can run read-only capabilities.
# readwrite/rw123 can run read and write capabilities.
LEGACYBRIDGE_RUNTIME_USER=readwrite
LEGACYBRIDGE_RUNTIME_PASSWORD=rw123
